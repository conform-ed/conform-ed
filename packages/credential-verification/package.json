{
  "name": "@conform-ed/credential-verification",
  "version": "0.0.0",
  "files": [
    "src",
    "dist",
    "vendor"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir dist --format esm --target node --external @conform-ed/contracts --external jose --external jsonld --external zod && tsc -p tsconfig.build.json",
    "format": "bun fmt --no-script --config ../../.oxfmtrc.jsonc --check .",
    "lint": "oxlint --config ../../.oxlintrc.jsonc .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@conform-ed/contracts": "workspace:*",
    "@zazuko/env-node": "^3.1.3",
    "asn1js": "^4.1.0",
    "jose": "^6.2.18",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "pkijs": "^4.0.1",
    "rdf-ext": "^2.6.0",
    "rdf-validate-shacl": "^0.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.6",
    "@types/rdf-ext": "^2.5.2"
  }
}
